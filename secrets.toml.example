# Copy to .streamlit/secrets.toml when running locally against a deployment
# config, or paste into Streamlit Cloud -> Settings -> Secrets.
# Never commit the real file.

# The key the shared demo spends. Visitors reach it only with APP_PASSWORD.
OPENAI_API_KEY = "sk-your-key-here"

# Unlocks the shared key. Visitors who would rather not trust you can paste
# their own key instead, on the other tab of the gate. Set this only in the
# Streamlit Cloud secrets box - it does not belong in the repo.
APP_PASSWORD = "choose-something"

# Caps what one visitor can spend on YOUR key: 2 rounds, 8 searches, the
# cheapest model, and the budget sliders hidden. Visitors on their own key are
# not capped.
DEMO_MODE = true
