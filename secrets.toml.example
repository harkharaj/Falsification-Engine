# Copy to .streamlit/secrets.toml when deploying, or paste into
# Streamlit Cloud -> Settings -> Secrets. Never commit the real file.

OPENAI_API_KEY = "sk-your-key-here"

# Optional: gate the app so only people you give the password to can spend
# your credit. Put the password in your README next to the link.
APP_PASSWORD = "choose-something"

# Optional: cap what one visitor can spend per audit (2 rounds, 8 searches,
# cheapest model) and hide the budget sliders.
DEMO_MODE = true
